{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dari: Init database",
      "type": "shell",
      "command": "php scripts/init_db.php",
      "windows": {
        "command": "php scripts\\init_db.php"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Dari: Start website",
      "type": "shell",
      "command": "php -S 127.0.0.1:8765 -t .",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "php",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Development Server|started|Listening|Failed)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Dari: Init DB and start website",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Dari: Init database",
        "Dari: Start website"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
